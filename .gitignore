*.backup

# Logs (IGNORAR)
*.log
logs/
*.pid

# Secret files (IGNORAR)
*.secret
*.key
*.pem
*.crt
.env
.secrets
*.p12
*.pfx

# Project specific - exports (IGNORAR)
exports/
temp/
output/
*.pdf
*.txt
!requirements.txt
!README.md

# Jupyter Notebook (IGNORAR)
.ipynb_checkpoints/
*.ipynb

# Pyre type checker (IGNORAR)
.pyre/

# pytype static type analyzer (IGNORAR)
.pytype/

# Cython debug symbols (IGNORAR)
cython_debug/

# Coverage reports (IGNORAR)
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# MyPy (IGNORAR)
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker (IGNORAR)
.pyre/

# pytype static type analyzer (IGNORAR)
.pytype/

# Backup files (IGNORAR)
*.backup
*.old
*.orig

# ====================
# NOTAS IMPORTANTES
# ====================
# 
# ✅ A pasta data/ é IGNORADA (dados sensíveis dos usuários)
# ✅ __pycache__ é IGNORADO (cache do Python)
# ✅ build/ é IGNORADO (arquivos temporários de build)
# ❌ dist/ NÃO está na lista - será incluído no commit
# ❌ O executável KAIRUS.exe será versionado via GitHub Releases
#
# Para distribuição do executável, use GitHub Releases:
# https://github.com/EduardoDosSantosFerreira/kairus/releases