# ====================
# kairus - Git Ignore
# ====================

# Database / User Data (IGNORAR - dados sensíveis do usuário)
data/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Python Cache (IGNORAR - arquivos temporários do Python)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc
*.pyo

# Build artifacts (IGNORAR - arquivos gerados durante build)
build/
dist/
*.spec
*.manifest
*.pyd
*.exe
!icon.png

# Virtual Environments (IGNORAR)
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
virtualenv/
venv*/

# Testing cache (IGNORAR)
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.dmypy.json
dmypy.json

# Distribution / packaging (IGNORAR)
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

